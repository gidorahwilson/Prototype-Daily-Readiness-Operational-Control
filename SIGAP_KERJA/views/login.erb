<!DOCTYPE html>
<html>
<head>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
  <div class="min-h-screen w-full bg-slate-950 text-slate-100 flex items-center justify-center px-4">
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-40 -left-40 w-[600px] h-[600px] bg-slate-800/40 rounded-full blur-3xl"></div>
    <div class="absolute bottom-[-200px] right-[-200px] w-[700px] h-[700px] bg-slate-700/30 rounded-full blur-3xl"></div>
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_1px_1px,rgba(255,255,255,0.06)_1px,transparent_0)] [background-size:24px_24px]"></div>
  </div>

  <div class="relative w-full max-w-5xl grid md:grid-cols-2 bg-slate-900/80 backdrop-blur-xl border border-slate-800 rounded-2xl shadow-2xl overflow-hidden">

    <div class="hidden md:flex flex-col justify-between p-10 bg-gradient-to-br from-slate-900 to-slate-800 border-r border-slate-800">
      <div>
        <div class="text-sm tracking-widest text-slate-400">ENTERPRISE SAFETY SYSTEM</div>
        <h1 class="mt-6 text-4xl font-semibold leading-tight">
          Daily Readiness<br/>Operational Control
        </h1>
        <p class="mt-6 text-slate-400 text-sm leading-relaxed">
          Monitoring kesiapan kerja harian operator, supervisor, dan manager
          dalam lingkungan operasional berisiko tinggi secara terstruktur,
          terdokumentasi, dan real-time.
        </p>
      </div>
      <div class="text-xs text-slate-500">
        © 2026 Office Operations — Internal Enterprise System
      </div>
    </div>

    <div class="p-8 md:p-12 flex items-center">
      <div class="w-full max-w-md mx-auto">
        <div class="mb-8">
          <div class="text-slate-400 text-sm">LOGIN ACCESS</div>
          <h2 class="text-2xl font-semibold mt-2">Masuk ke Sistem</h2>
        </div>

        <form action="/login" method="post" class="space-y-6">
          <div>
            <label class="block text-sm text-slate-400 mb-2">Email</label>
            <input name="email" type="email" required class="w-full px-4 py-3 rounded-lg bg-slate-800 border border-slate-700 text-sm" required />
          </div>

          <button type="submit" class="w-full py-3 rounded-lg bg-slate-200 text-slate-900 font-semibold">
            Login ke Dashboard
          </button>
        </form>

      </div>
    </div>
  </div>
</div>
</body>
</html>
